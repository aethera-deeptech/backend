# The environment the service runs in, development or production
APP_ENV=development
# The port the service listens on
APP_PORT=8080

# Docker Compose, read by compose.production.example.yml and scripts/rolling-update.sh
# The image tag that the copies run, the rolling update script sets it to the version that it installs
IMAGE_TAG=0.1.0
# The limits of one copy, the Go memory limit stays below the memory limit of the container
GOMEMLIMIT=100MiB
API_MEMORY_LIMIT=128m
API_CPUS=0.50
# How long Docker waits for a copy to stop, longer than the 15 seconds that the service waits for running requests
API_STOP_GRACE_PERIOD=20s
# The loopback ports of the two copies, the reverse proxy lists them as its upstream
API_1_HOST_PORT=8010
API_2_HOST_PORT=8011
# The size and the number of the log files of a container
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
