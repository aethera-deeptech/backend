# The environment the service runs in, development or production
APP_ENV=development
# The port the service listens on
APP_PORT=8080

# The origin of the web app. CORS allows only this origin and the links in the emails point to it. It must use https in production.
APP_ORIGIN=http://localhost:5173
# Set TRUST_PROXY when a reverse proxy on the same host sits in front. The service then reads the client address from PROXY_HEADER.
TRUST_PROXY=false
PROXY_HEADER=X-Real-IP
# Optional. A comma separated list of IPs or CIDR ranges that may set that header, for example the gateway of the Docker network of the
# proxy. Without it every private and loopback address is trusted, which includes other containers on a shared Docker network.
# TRUST_PROXY_CIDRS=172.18.0.1
# Error reports to Sentry. A 5xx and a panic are sent with the error text, the stack, the route pattern and the status, scrubbed of emails,
# tokens and long numbers, and never with a request body, a header or a cookie. An empty SENTRY_DSN switches the reports off. The DSN is a
# secret in practice, so keep it in this file only. SENTRY_EVENTS_PER_MINUTE is the most events that leave in a minute.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_SERVER_NAME=sora
# SENTRY_EVENTS_PER_MINUTE=30
# The mail server. SMTP_SECURITY is tls (implicit TLS, port 465), starttls (port 587) or none. Production needs a host and a sender.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=tls
SMTP_FROM_NAME=Aethera
SMTP_FROM_ADDRESS=
# The database. The service migrates it when it starts. DB_SSL_MODE is require unless it is set, and disable is only for a database on a
# private Docker network. Two copies share the database, so keep DB_MAX_CONNS times the number of copies below its connection limit.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aethera
DB_USERNAME=aethera
DB_PASSWORD=change-me
DB_SSL_MODE=disable
DB_MAX_CONNS=8
# Docker Compose, read by compose.production.example.yml and scripts/rolling-update.sh
# The Docker network that the database container is on, which compose.production.example.yml joins from outside
DB_NETWORK=postgres_postgres
# The image tag that the copies run. It stays empty on purpose, so a docker compose up -d cannot start a version that does not exist.
# The rolling update script sets it to the version that it installs
IMAGE_TAG=
# The limits of one copy, the Go memory limit stays below the memory limit of the container
GOMEMLIMIT=100MiB
API_MEMORY_LIMIT=128m
API_CPUS=0.50
# How long Docker waits for a copy to stop, longer than the 15 seconds that the service waits for running requests
API_STOP_GRACE_PERIOD=20s
# The loopback ports of the two copies, the reverse proxy lists them as its upstream
API_1_HOST_PORT=8010
API_2_HOST_PORT=8011
# The size and the number of the log files of a container
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
