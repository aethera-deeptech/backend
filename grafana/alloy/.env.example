# Settings of Alloy, copied to grafana/alloy/.env on the host. Only the alloy container loads this file, so the API copies never see the token.
# The push URL and the user of the Prometheus and the Loki data source are in the connection details of the Grafana Cloud stack.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
# The token of an access policy with the scopes metrics:write and logs:write and nothing else
GRAFANA_CLOUD_TOKEN=
# The name of this host on every series and log line, which has to differ between hosts
GRAFANA_HOST=main
