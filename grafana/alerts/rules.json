  {
    "title": "An API copy keeps restarting",
    "ruleGroup": "aethera",
    "folderUID": "aethera",
    "orgID": 1,
    "for": "0s",
    "condition": "C",
    "noDataState": "OK",
    "execErrState": "Error",
    "isPaused": false,
    "labels": {
      "severity": "critical",
      "service": "aethera-api"
    },
    "annotations": {
      "summary": "{{ $labels.instance }} on {{ $labels.host }} started more than once in 30 minutes. A crash loop or an out of memory kill is the usual cause, so read the container log and the exit code of the container (docker inspect, OOMKilled)"
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "__PROMETHEUS_UID__",
        "model": {
          "refId": "A",
          "expr": "max by (host, instance) (changes(process_start_time_seconds{service=\"aethera-api\"}[30m]))",
          "instant": true,
          "intervalMs": 60000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "relativeTimeRange": {
