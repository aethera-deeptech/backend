  {
    "title": "API memory is close to its limit",
    "ruleGroup": "aethera",
    "folderUID": "aethera",
    "orgID": 1,
    "for": "5m",
    "condition": "C",
    "noDataState": "OK",
    "execErrState": "Error",
    "isPaused": false,
    "labels": {
      "severity": "warning",
      "service": "aethera-api"
    },
    "annotations": {
      "summary": "{{ $labels.instance }} on {{ $labels.host }} has used more than 110 MiB of resident memory for 5 minutes. The default limit of a copy is 128 MiB and the container is killed above it, so look at the logs and at the process metrics of the copy in Explore"
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "__PROMETHEUS_UID__",
        "model": {
          "refId": "A",
          "expr": "max by (host, instance) (process_resident_memory_bytes{service=\"aethera-api\"})",
          "instant": true,
          "intervalMs": 60000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  115343360
                ]
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      }
    ]
