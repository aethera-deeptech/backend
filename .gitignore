# Binaries. go build writes into the folder it runs in, and the binary of the root module is named after the repository.
/bin/
/backend
*.exe
*.test
*.out
__debug_bin*

# Test, coverage and profile output
coverage.*
!coverage.go
*.coverprofile
profile.cov
*.prof
*.pprof

# Go workspace files
go.work
go.work.sum

# Local configuration. The example file is committed, and the pattern matches in every folder.
.env
.env.*
!.env.example
.envrc
compose.override.y*ml
docker-compose.override.y*ml

# Python bytecode
__pycache__/
*.pyc

# The data that k6/prepare.py makes for a run, with a session and gateway keys of a throwaway stack
k6/setup.json

# Keys and certificates
*.pem
*.key

# Logs
*.log

# Tool downloads
node_modules/
dist/

# Editors and OS
.idea/
.vscode/
.DS_Store
# Vale downloads the Google style here, only the Aethera rules are committed
.github/vale/styles/*
!.github/vale/styles/Aethera/
